# Ultra-high precision settings for low-amplitude hidden-mode convergence checks.
# This preset is intentionally stricter than observational_forecast/high_precision.pre
# and is used only to test the 10% frozen-direction response against the 20/30%
# scaling regime. It is not the production default.

tol_ncdm_bg = 1.e-12
tol_ncdm_synchronous = 1.e-12
tol_ncdm_newtonian = 1.e-12
tol_perturbations_integration = 1.e-9
perturbations_sampling_stepsize = 0.004
l_max_ncdm = 70
q_linstep = 0.05
q_logstep_spline = 50.
q_logstep_trapzd = 0.12
q_numstep_transition = 700
l_logstep = 1.008
l_linstep = 6
